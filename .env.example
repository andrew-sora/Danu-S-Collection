# Environment Variables — Danu's Collection
# Copy file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke git.

# URL CSV dari Google Sheet yang sudah di-publish (File → Share → Publish to web → CSV)
# Contoh: https://docs.google.com/spreadsheets/d/XXXX/pub?gid=0&single=true&output=csv
SHEET_CSV_URL=

# Secret acak untuk melindungi endpoint revalidasi.
# Akses: GET /api/revalidate?secret=<nilai ini>
# Generate: -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 32 | % {[char]$_})
REVALIDATE_SECRET=

# Nomor WhatsApp bisnis (format internasional TANPA tanda +)
# Contoh: 6281234567890
NEXT_PUBLIC_WA_NUMBER=

# URL produksi untuk canonical / Open Graph metadata
# Development: http://localhost:3000
# Production: https://danus-collection.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
